# systemd --user unit for the BirdNET bird-song detector.
# Install with scripts/install-birds-service.sh (copies this to
# ~/.config/systemd/user/ and enables it). Adjust paths if your checkout
# is not at /home/jetson/birdsong-jetson.
[Unit]
Description=Birdsong BirdNET detector (mic -> BirdNET -> overlay + Birdy context)
After=pipewire.service wireplumber.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=/home/jetson/birdsong-jetson
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Pin capture to the USB mic. Power-mode switches and reboots re-enumerate
# devices and WirePlumber can fall back to the onboard analog input (nothing
# plugged in = a stream of perfect silence that defeats stall detection).
Environment=BIRDSONG_SOURCE=alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-mono
# Wait for PipeWire to expose the USB mic before capturing. Starting during
# the boot race leaves parecord attached to nothing: the service looks
# "active" but is deaf (blocked forever on a silent pipe).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 45); do pactl list sources short 2>/dev/null | grep -q "alsa_input.usb" && exit 0; sleep 2; done; echo "no USB mic source after 90s" >&2; exit 1'
ExecStart=/home/jetson/birdsong-jetson/.venv-birds/bin/python -u /home/jetson/birdsong-jetson/birds/detector.py
StandardOutput=append:/home/jetson/birdsong-jetson/birds.log
StandardError=append:/home/jetson/birdsong-jetson/birds.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
