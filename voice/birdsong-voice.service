# systemd --user unit for the Birdsong voice assistant.
# Install with scripts/install-voice-service.sh (copies this to
# ~/.config/systemd/user/ and enables it). Adjust paths if your checkout
# is not at /home/jetson/birdsong-jetson.
[Unit]
Description=Birdsong voice assistant (wake word -> STT -> Gemma -> TTS)
After=pipewire.service wireplumber.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=/home/jetson/birdsong-jetson
Environment=XDG_RUNTIME_DIR=/run/user/1000
# Custom-trained wake word: "hey birdy" (openWakeWord ONNX model).
Environment=BIRDSONG_WAKE=/home/jetson/birdsong-jetson/voice/models/hey_birdy.onnx
# Wait for PipeWire to expose the USB mic before capturing. Starting during
# the boot race leaves parecord attached to nothing: the service looks
# "active" but is deaf (blocked forever on a silent pipe).
ExecStartPre=/bin/sh -c 'for i in $(seq 1 45); do pactl list sources short 2>/dev/null | grep -q alsa_input && exit 0; sleep 2; done; echo "no mic source after 90s" >&2; exit 1'
ExecStart=/home/jetson/birdsong-jetson/.venv-voice/bin/python -u /home/jetson/birdsong-jetson/voice/assistant.py
StandardOutput=append:/home/jetson/birdsong-jetson/voice.log
StandardError=append:/home/jetson/birdsong-jetson/voice.log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
